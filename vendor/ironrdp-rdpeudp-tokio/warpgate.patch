-pub(crate) trait DatagramIo: Send + Sync + 'static {
+/// A connected datagram endpoint the driver sends and receives through.
+///
+/// Implemented for a [`UdpSocket`] `connect()`ed to its peer. A server that
+/// takes every connection on one UDP port, as MS-RDPEUDP 2.1 and 3.1.3
+/// describe, demultiplexes that port itself and implements this for each
+/// peer's share of the traffic, handing it to
+/// [`accept_udp_with_datagram_io`](crate::accept_udp_with_datagram_io).
+pub trait DatagramIo: Send + Sync + 'static {
+    /// The local address datagrams are sent from, if known.
     fn local_addr(&self) -> Option<SocketAddr>;
+    /// The one peer this endpoint exchanges datagrams with.
     fn peer_addr(&self) -> Option<SocketAddr>;
+    /// Sends one datagram to the peer.
     fn send<'a>(&'a self, buf: &'a [u8]) -> impl Future<Output = io::Result<usize>> + Send + 'a;
+    /// Receives the peer's next datagram into `buf`, returning its length.
+    ///
+    /// The driver awaits this inside `tokio::select!`, so it must be
+    /// cancellation safe: a datagram is either returned or left for the
+    /// next call.
     fn recv<'a>(&'a self, buf: &'a mut [u8]) -> impl Future<Output = io::Result<usize>> + Send + 'a;
 }
 
