+/// A `PAKID_CORE_DEVICE_IOREQUEST` carrying `request`, framed as
+/// [`RdpdrServer::send_device_io_request`] frames it.
+fn encode_drive_request<T: DriveRequestBody>(request: &T) -> EncodeResult<Vec<u8>> {
+    let mut bytes = vec![0u8; SHARED_HEADER_SIZE + request.wire_size()];
+    let mut dst = WriteCursor::new(&mut bytes);
+    dst.write_u16(Component::RdpdrCtypCore.into());
+    dst.write_u16(PacketId::CoreDeviceIoRequest.into());
+    request.encode_into(&mut dst)?;
+    Ok(bytes)
+}
