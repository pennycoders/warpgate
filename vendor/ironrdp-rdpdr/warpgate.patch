+            ),
+            ServerDriveIoRequest::DeviceCloseRequest(r) => (&r.device_io_request, PendingIrp::Close),
+            ServerDriveIoRequest::ServerDriveQueryDirectoryRequest(r) => (
+                &r.device_io_request,
+                PendingIrp::QueryDirectory {
+                    info_class: r.file_info_class_lvl.clone(),
+                },
+            ),
+            ServerDriveIoRequest::ServerDriveNotifyChangeDirectoryRequest(r) => {
+                (&r.device_io_request, PendingIrp::NotifyChangeDirectory)
+            }
+            ServerDriveIoRequest::ServerDriveQueryVolumeInformationRequest(r) => (
+                &r.device_io_request,
+                PendingIrp::QueryVolumeInformation {
+                    volume_info_class: r.fs_info_class_lvl.clone(),
+                },
+            ),
+            ServerDriveIoRequest::DeviceControlRequest(_) => {
+                return Err(pdu_other_err!("RdpdrServer", "device control requests are not forwarded"));
+            }
+            ServerDriveIoRequest::DeviceReadRequest(r) => (&r.device_io_request, PendingIrp::Read),
+            ServerDriveIoRequest::DeviceWriteRequest(r) => (&r.device_io_request, PendingIrp::Write),
+            ServerDriveIoRequest::DeviceFlushBuffersRequest(r) => (&r.device_io_request, PendingIrp::FlushBuffers),
+            ServerDriveIoRequest::ServerDriveSetInformationRequest(r) => {
+                (&r.device_io_request, PendingIrp::SetInformation)
+            }
+            ServerDriveIoRequest::ServerDriveLockControlRequest(r) => (&r.device_io_request, PendingIrp::LockControl),
+            ServerDriveIoRequest::ServerDriveQuerySecurityRequest(r) => {
+                (&r.device_io_request, PendingIrp::QuerySecurity)
+            }
+            ServerDriveIoRequest::ServerDriveSetSecurityRequest(r) => (&r.device_io_request, PendingIrp::SetSecurity),
