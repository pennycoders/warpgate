+            ServerDriveIoRequest::ServerDriveNotifyChangeDirectoryRequest(r) => encode_drive_request(r),
+            ServerDriveIoRequest::ServerDriveQueryVolumeInformationRequest(r) => encode_drive_request(r),
+            ServerDriveIoRequest::DeviceReadRequest(r) => encode_drive_request(r),
+            ServerDriveIoRequest::DeviceWriteRequest(r) => encode_drive_request(r),
+            ServerDriveIoRequest::DeviceFlushBuffersRequest(r) => encode_drive_request(r),
+            ServerDriveIoRequest::ServerDriveSetInformationRequest(r) => encode_drive_request(r),
