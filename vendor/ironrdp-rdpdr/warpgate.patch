+    /// Sends a drive request decoded from another RDPDR channel, keeping its `DeviceId`,
+    /// `FileId` and `CompletionId`.
+    ///
+    /// This is what a proxy terminating RDPDR on both sides needs: the request a server
+    /// sent it is re-encoded whole to the client that owns the drive, rather than rebuilt
+    /// through the `drive_*` methods, which pick their own completion ids and fix some
+    /// fields (create attributes and share access). Keeping the server's ids means the
+    /// client's completion can be handed back to that server unchanged.
+    ///
+    /// The device must have been announced by this client and accepted, and the
+    /// `CompletionId` must not already be pending. Device control is not forwarded: its
+    /// input buffer is not part of [`ServerDriveIoRequest`]. A request that can't be sent
+    /// goes to [`RdpdrServerBackend::on_forward_rejected`] instead of failing the channel,
+    /// so the proxy can complete it toward the server it came from.
+    pub fn forward_drive_io_request(&mut self, request: ServerDriveIoRequest) -> PduResult<Vec<SvcMessage>> {
+        match self.try_forward_drive_io_request(&request) {
+            Ok(messages) => Ok(messages),
+            Err(error) => {
+                warn!(%error, "not forwarding drive request");
+                self.backend.on_forward_rejected(request);
+                Ok(Vec::new())
+            }
