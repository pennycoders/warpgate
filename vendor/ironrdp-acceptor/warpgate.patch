+    #[test]
+    fn an_rdp_10_server_reserves_the_windows_10_edge_actions() {
+        use gcc::ServerEarlyCapabilityFlags as Flags;
+
+        let flags = |version, skip| {
+            create_gcc_blocks(1003, vec![], SecurityProtocol::SSL, version, skip, None, None)
